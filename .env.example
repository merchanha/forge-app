# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase service role — SERVER ONLY. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Coach (Phase 9) — SERVER ONLY. Never put these in NEXT_PUBLIC_*.
# Provider is agnostic via the Vercel AI SDK. Default stub needs no keys.
AI_COACH_PROVIDER=stub
# AI_COACH_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_COACH_MODEL=gpt-4o-mini
# AI_COACH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_COACH_MODEL=claude-haiku-4-5-20251001
# AI_COACH_DAILY_LIMIT=10
# AI_COACH_MAX_OUTPUT_TOKENS=2500
# AI_COACH_TIMEOUT_MS=30000
